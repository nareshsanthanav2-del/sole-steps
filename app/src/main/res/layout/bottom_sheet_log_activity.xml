<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_dark"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="AI"
            android:src="@drawable/ic_sparkle"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="Log an activity"
            android:textColor="@color/white"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Activity"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etActivityName"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_outlined"
        android:hint="Evening walk"
        android:inputType="textCapSentences"
        android:paddingHorizontal="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_muted"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="How long?"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip15"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="15 min"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chip30"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_white_pill"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="30 min"
            android:textColor="@color/oled_black"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chip45"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="45 min"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chip60"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="1 hr"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipOther"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_outline"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Other"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etCustomMinutes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_subtle"
        android:hint="Enter minutes (e.g. 75)"
        android:inputType="number"
        android:paddingHorizontal="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_muted"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnSaveActivity"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_white_pill"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="Save activity"
        android:textColor="@color/oled_black"
        android:textSize="16sp" />

</LinearLayout>
